PORT=3000
# Path to arduino-cli if it is not on PATH
ARDUINO_CLI_PATH=arduino-cli
# Where temporary sketch/build folders are created
# COMPILE_WORK_DIR=/tmp
COMPILE_TIMEOUT_MS=120000
MAX_CONCURRENT_COMPILES=2
MAX_QUEUED_COMPILES=20
MAX_SOURCE_BYTES=262144
MAX_FILES=20
# Comma-separated vendor:arch:board list. Empty = every installed board.
ALLOWED_FQBNS=
RATE_LIMIT_PER_MINUTE=30
# Reverse-proxy hops to trust for client IP (set to 1 behind nginx/a load balancer)
TRUST_PROXY=0
